{
  "name": "piano-teacher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Piano teacher web app: listens to your piano and teaches you from beginner to master.",
  "scripts": {
    "start": "npx http-server -c-1 -p 8080 .",
    "test": "node --test",
    "eval": "node tests/eval-transcriber.js",
    "test:audio": "node --test tests/audio.test.js",
    "test:songs": "node --test tests/songs.test.js tests/midi.test.js",
    "eval:noise": "node tests/noise-eval.js",
    "corpus": "node tests/corpus-fetch.js",
    "fit": "node tests/noise-fit.js",
    "e2e": "node e2e/smoke.mjs",
    "bench": "node tests/bench-listen.js",
    "bench:fetch": "node tests/bench-fetch.js",
    "fit:look": "node tests/look-fit.js"
  }
}
